# Supabase project settings. Both values are safe for browser use when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Required exclusively for the administrative Worker Auth invite.
# Never expose this value in NEXT_PUBLIC_* variables or Client Components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
WORKER_APP_URL=http://localhost:3000

# Server-only secrets, such as SUPABASE_SERVICE_ROLE_KEY and SENTRY_DSN, are not
# needed by Foundation Core. Never prefix server-only values with NEXT_PUBLIC_.
