# Supabase project settings. Both values are safe for browser use when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Required for Worker and Core Auth invitations.
# Never expose this value in NEXT_PUBLIC_* variables or Client Components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
WORKER_APP_URL=http://localhost:3000
CORE_APP_URL=http://localhost:3000

# Never prefix server-only values such as SUPABASE_SERVICE_ROLE_KEY with NEXT_PUBLIC_.
